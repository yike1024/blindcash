# .dockerignore — Phase 5
# 不拷入构建上下文的文件/目录

# Git
.git
.gitignore

# Node modules（用 npm ci 重新装）
**/node_modules

# 构建产物（builder stage 重新 build）
frontend/dist

# 数据库（运行时写 volume，不进镜像）
backend/data
**/*.db
**/*.db-wal
**/*.db-shm

# 日志
**/*.log

# 环境变量（secrets 不进镜像）
**/.env
**/.env.*

# 编辑器/OS
.vscode
.idea
.DS_Store
*.swp

# 测试（不进生产镜像，但构建时需要 clientBuild.test.js？不需要——
# vite build 不依赖测试。tests/ 不进 runtime 镜像）
backend/tests
frontend/src/__tests__

# 文档（openapi.yaml 要进镜像，所以只排除不需要的）
# docs/openapi.yaml 需要 COPY，所以这里不排除 docs/

# k6 脚本（运行时不需要）
benchmarks
tests/load

# package-lock 由 package*.json 触发，不需要单独排除
